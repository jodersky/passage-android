<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Passage" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- transparent, so that only the authentication prompt shows over the app being filled -->
    <style name="Theme.Passage.Autofill" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
