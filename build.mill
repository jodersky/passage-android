//| mill-version: 1.3.1
//| mill-jvm-version: zulu:21
package build

import mill.*, androidlib.*, kotlinlib.*

object androidSdkModule0 extends AndroidSdkModule {
  def buildToolsVersion = "35.0.0"
}

// Platform-independent logic (age, crypto glue). Plain JVM module so that it
// can be tested on the desktop; the app depends on it.
object core extends KotlinModule {
  def kotlinVersion = "2.0.21"

  def mvnDeps = Seq(
    mvn"com.exceptionfactory.jagged:jagged-api:1.0.0",
    mvn"com.exceptionfactory.jagged:jagged-framework:1.0.0",
    mvn"com.exceptionfactory.jagged:jagged-bech32:1.0.0",
    mvn"com.exceptionfactory.jagged:jagged-x25519:1.0.0",
    mvn"com.exceptionfactory.jagged:jagged-ssh:1.0.0",
    mvn"org.bouncycastle:bcprov-jdk18on:1.86"
  )

  object test extends KotlinTests, TestModule.Junit5 {
    def mvnDeps = Seq(
      mvn"org.jetbrains.kotlin:kotlin-test-junit5:2.0.21",
      mvn"com.github.sbt.junit:jupiter-interface:0.11.2"
    )
  }
}

// Throwaway SSH server for testing the app against, on the desktop:
// `mill testserver.run <authorized_keys> [port]`, then
// `adb reverse tcp:2222 tcp:2222` so the phone can reach it.
object testserver extends KotlinModule {
  def kotlinVersion = "2.0.21"

  def mvnDeps = Seq(
    mvn"org.apache.sshd:sshd-core:2.20.0",
    mvn"org.slf4j:slf4j-simple:2.0.20"
  )
}

object app extends AndroidAppKotlinModule {
  def kotlinVersion = "2.0.21"
  def androidSdkModule = mill.api.ModuleRef(androidSdkModule0)
  def androidCompileSdk = 35
  def androidMinSdk = 35
  def androidEnableCompose = true
  def androidIsDebug = true

  def androidApplicationId = "io.crashbox.passage"
  def androidApplicationNamespace = "io.crashbox.passage"

  def moduleDeps = Seq(core)

  def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"androidx.core:core-ktx:1.15.0",
    mvn"androidx.activity:activity-compose:1.10.0",
    mvn"androidx.compose.material3:material3:1.3.1",
    mvn"androidx.compose.ui:ui:1.7.6",
    mvn"androidx.lifecycle:lifecycle-runtime-compose:2.8.7",
    mvn"androidx.lifecycle:lifecycle-viewmodel-compose:2.8.7",
    mvn"com.hierynomus:sshj:0.41.2",
    // coursier ignores Gradle module metadata version constraints, so these
    // transitive artifacts must be pinned to avoid duplicate classes in d8
    mvn"androidx.collection:collection-jvm:1.4.4",
    mvn"androidx.collection:collection-ktx:1.4.4",
    mvn"androidx.lifecycle:lifecycle-common:2.8.7",
    mvn"androidx.lifecycle:lifecycle-process:2.8.7",
    mvn"androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.7",
    // classes move between BouncyCastle jars across versions, so all of
    // them must have the same version as core's bcprov
    mvn"org.bouncycastle:bcpkix-jdk18on:1.86",
    mvn"org.bouncycastle:bcutil-jdk18on:1.86"
  )
}
